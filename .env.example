# Postgres connection string. Local Docker default (see docker-compose.yml):
# postgresql://obsidian:obsidian@localhost:5432/obsidian
# This project uses a hosted Postgres (e.g. Neon) in development — either works.
DATABASE_URL=

# Qdrant vector database.
# Local Docker default: http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# OpenAI API. If OPENAI_BASE_URL is left empty, the official OpenAI API is used
# and OPENAI_API_KEY must be a real OpenAI key (sk-proj-...).
# To use OpenRouter for chat completions, set
# OPENAI_BASE_URL=https://openrouter.ai/api/v1 and use a provider-prefixed
# chat model id, e.g. openai/gpt-4o-mini.
#
# OpenRouter has no /v1/embeddings endpoint, so embeddings must go to a real
# OpenAI-compatible embeddings API. Leave OPENAI_EMBEDDING_BASE_URL empty to
# use the official OpenAI API for embeddings (with a real OpenAI key), or
# point it at another OpenAI-compatible embeddings provider. It falls back to
# OPENAI_BASE_URL only when explicitly set to one.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Auth.js (NextAuth v5) - Google OAuth only.
# AUTH_SECRET: generate with `bunx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudinary - stores uploaded documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini vision, used to OCR/describe uploaded images (.png/.jpg/.jpeg/.webp).
# Get a key at https://aistudio.google.com/apikey. Optional - without it,
# image uploads fail cleanly with an "Image OCR is not configured" error;
# every other upload type still works.
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash if left empty.
GEMINI_VISION_MODEL=

# Max accepted upload size in bytes. Defaults to 20971520 (20 MB) if left
# empty. Per-source-type caps (registry.ts) are clamped by this value.
MAX_UPLOAD_BYTES=
